# Required for database runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required for admin API protection
ADMIN_API_TOKEN=replace-with-a-long-random-secret

# Production checkout mode: demo | paypal | disabled
# Use paypal only when BOTH PayPal credentials are configured.
CHECKOUT_MODE=paypal

# Legacy toggle kept for compatibility; disable in production.
DEMO_CHECKOUT_ENABLED=false

# Optional SEO / branding
SITE_URL=https://example.com
SITE_NAME=GlobalOmni AI™ - 24/7 AI Live Stream & Traffic Engine
SITE_DESCRIPTION=Turn your international .COM domain into a high-converting automated traffic and monetization machine.

# Optional AI provider integration (kept safe if unset)
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Required for live PayPal checkout in production
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_SECRET=
PAYPAL_MODE=sandbox

# Optional affiliate payout configuration (non-sensitive metadata)
AFFILIATE_PAYOUT_EMAIL=
AFFILIATE_COMMISSION_RATE=30

# Optional public site defaults
NEXT_PUBLIC_APP_NAME=GlobalOmni AI
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com